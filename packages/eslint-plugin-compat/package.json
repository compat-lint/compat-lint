{
  "name": "@compat-lint/eslint-plugin-compat",
  "version": "8.0.2",
  "description": "Lint browser compatibility of API used",
  "keywords": [
    "eslint",
    "browser",
    "support",
    "api",
    "lint",
    "caniuse",
    "kangax"
  ],
  "homepage": "https://github.com/compat-lint/compat-lint/tree/main/packages/eslint-plugin-compat#readme",
  "bugs": {
    "url": "https://github.com/compat-lint/compat-lint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/compat-lint/compat-lint.git",
    "directory": "packages/eslint-plugin-compat"
  },
  "license": "MIT",
  "author": "Amila Welihinda",
  "contributors": [
    "Amila Welihinda <amilajack@gmail.com> (https://github.com/amilajack)",
    "John Tran <jptran318@gmail.com> (https://github.com/jooohhn)"
  ],
  "main": "./lib/cjs/src/index.js",
  "types": "./lib/cjs/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/src/index.d.ts",
        "default": "./lib/esm/src/index.js"
      },
      "require": {
        "types": "./lib/cjs/src/index.d.ts",
        "default": "./lib/cjs/src/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "benchmarks": "ts-node-transpile-only test/benchmarks.ts",
    "build": "rm -rf lib && tsc --project tsconfig.build.json && tsc --project tsconfig.esm.json",
    "lint": "eslint .",
    "prettier": "prettier --check .",
    "prettier:write": "prettier --write .",
    "spec": "jest --testPathIgnorePatterns test/e2e-repo.spec.ts /benchmarks-tmp",
    "spec:e2e": "npm run build && NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles test/e2e-repo.spec.ts",
    "test": "npm run build && npm run lint && npm run spec",
    "tsc": "tsc"
  },
  "prettier": {
    "semi": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/benchmarks-tmp/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/benchmarks-tmp/",
      "<rootDir>/lib/[^/]+/package.json"
    ]
  },
  "dependencies": {
    "@compat-lint/ast-metadata-inferer": "workspace:^",
    "browserslist": "^4.29.2",
    "caniuse-lite": "^1.0.30001813",
    "find-up": "^5.0.0",
    "globals": "^17.5.0",
    "lodash.memoize": "^4.1.2",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^9.39.4",
    "@tsconfig/node16": "^16.1.8",
    "@types/benchmark": "^2.1.5",
    "@types/caniuse-lite": "^1.0.5",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/lodash.memoize": "^4.1.9",
    "@types/node": "^24.19.0",
    "@types/semver": "7.8.0",
    "benchmark": "^2.1.4",
    "browserslist-config-erb": "^0.0.3",
    "electron": "^41.x.x",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-plugin": "^7.3.2",
    "eslint-plugin-prettier": "^5.5.5",
    "expect-type": "^1.3.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "simple-git": "^3.36.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "engines": {
    "node": ">=22.x"
  },
  "collective": {
    "type": "opencollective",
    "url": "https://opencollective.com/eslint-plugin-compat",
    "logo": "https://opencollective.com/opencollective/logo.txt"
  }
}
